<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="neon_accent">#22D3EE</color>
    <color name="neon_accent_dark">#0F172A</color>
    <color name="neon_bg">#0A0E27</color>
    <string name="app_name">Neon Defense</string>
    <style name="Theme.NeonDefense" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/neon_bg</item>
        <item name="android:statusBarColor">@color/neon_bg</item>
        <item name="android:navigationBarColor">@color/neon_bg</item>
    </style>
    <style name="Theme.NeonDefense.Fullscreen" parent="Theme.NeonDefense">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>