#!/bin/sh
#
# Gradle wrapper startup script for Unix.
# Generated from official Gradle template — safe for CI use.

##############################################################################
# Helpers
##############################################################################

die() {
    echo
    echo "ERROR: $*"
    echo
    exit 1
}

##############################################################################
# Resolve APP_HOME
##############################################################################

PRG="$0"
while [ -h "$PRG" ]; do
    ls=$(ls -ld "$PRG")
    link=$(expr "$ls" : '.*-> \(.*\)$')
    if expr "$link" : '/.*' > /dev/null; then
        PRG="$link"
    else
        PRG=$(dirname "$PRG")"/$link"
    fi
done

SAVED="$(pwd)"
cd "$(dirname "$PRG")/" >/dev/null || die "cd failed"
APP_HOME="$(pwd -P)"
cd "$SAVED" >/dev/null || die "cd failed"

APP_NAME="Gradle"
APP_BASE_NAME=$(basename "$0")

##############################################################################
# Java
##############################################################################

if [ -n "$JAVA_HOME" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
    [ -x "$JAVACMD" ] || die "JAVA_HOME is invalid: $JAVA_HOME"
else
    JAVACMD="java"
    command -v java >/dev/null 2>&1 || die "java not found in PATH and JAVA_HOME not set"
fi

##############################################################################
# Build argument list and exec
##############################################################################

CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

# shellcheck disable=SC2086
exec "$JAVACMD" \
    -Xmx64m \
    -Xms64m \
    "-Dorg.gradle.appname=$APP_BASE_NAME" \
    -classpath "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain \
    "$@"
